{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "paths": {
      "pathe": ["node_modules/pathe"],
      "pathe/*": ["node_modules/pathe/*"],
      "radash": ["node_modules/radash"],
      "radash/*": ["node_modules/radash/*"],
      "gray-matter": ["node_modules/gray-matter"],
      "gray-matter/*": ["node_modules/gray-matter/*"],
      "@tachikoma/core": ["packages/core/src/index.ts"],
      "@tachikoma/core/*": ["packages/core/src/*"],
      "@tachikoma/web-clipper": ["apps/web-clipper/src/index.ts"],
      "@tachikoma/web-clipper/*": ["apps/web-clipper/src/*"],
      "@tachikoma/douyin-sync": ["apps/douyin-sync/src/index.ts"],
      "@tachikoma/douyin-sync/*": ["apps/douyin-sync/src/*"],
      "@tachikoma/cli": ["apps/cli/src/index.ts"],
      "@tachikoma/cli/*": ["apps/cli/src/*"]
    },
    "noEmit": true
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "tests/**/*"
  ]
}
