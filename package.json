{
  "name": "tachikoma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tachikoma — 个人第二大脑统一多模态情报摄入引擎",
  "scripts": {
    "svc": "node --import tsx scripts/service.ts",
    "svc:status": "node --import tsx scripts/service.ts status",
    "svc:start": "node --import tsx scripts/service.ts start",
    "svc:stop": "node --import tsx scripts/service.ts stop",
    "svc:restart": "node --import tsx scripts/service.ts restart",
    "svc:autostart:off": "node --import tsx scripts/service.ts autostart:disable",
    "svc:autostart:on": "node --import tsx scripts/service.ts autostart:enable",
    "build": "pnpm --filter @tachikoma/cli build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.14",
    "gray-matter": "^4.0.3",
    "jsonrepair": "^3.15.0",
    "pathe": "^2.0.3",
    "radash": "^12.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
